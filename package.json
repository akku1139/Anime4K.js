{
  "name": "anime4k.js",
  "version": "0.0.7",
  "description": "Anime4K WebGL port/implementation",
  "keywords": [
    "anime4k",
    "webgl",
    "glsl",
    "upscale",
    "upscaler",
    "image",
    "video"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/monyone/Anime4K.js"
  },
  "main": "dist/anime4k.js",
  "types": "d.ts/index.d.ts",
  "files": [
    "dist/**/*",
    "d.ts/**/*",
    "src/**/*",
    "tsconfig.json"
  ],
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist d.ts",
    "build": "esbuild src/index.ts --outfile=dist/anime4k.js --platform=neutral --bundle --minify",
    "build:dev": "esbuild src/index.ts --outfile=dist/anime4k.js --platform=neutral --bundle",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^5.9.3"
  }
}
